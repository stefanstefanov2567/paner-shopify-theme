{%- comment -%} PanER · Често задавани въпроси {%- endcomment -%}
<section class="paner-section color-{{ section.settings.color_scheme }} gradient" id="faq">
  <div class="page-width">
    <div class="paner-faq">
      <div class="paner-faq__aside">
        <p class="paner-eyebrow paner-eyebrow--accent">ВЪПРОСИ И ОТГОВОРИ</p>
        <h2 class="paner-section__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="paner-section__sub">{{ section.settings.text }}</div>
        {%- endif -%}
        <div class="paner-faq__contact">
          <strong>{{ section.settings.contact_heading }}</strong>
          <span>{{ section.settings.contact_text }}</span>
          {%- if settings.paner_phone != blank -%}
            <a class="paner-faq__phone" href="tel:{{ settings.paner_phone | remove: ' ' }}">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
              {{ settings.paner_phone }}
            </a>
          {%- endif -%}
          <a class="button button--full-width paner-btn--dark" href="{{ settings.inquiry_link | default: '/pages/contact' }}">Изпрати запитване</a>
        </div>
      </div>

      <div class="paner-faq__list">
        {%- for block in section.blocks -%}
          <details class="paner-faq__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
            <summary class="paner-faq__q">
              <span>{{ block.settings.question }}</span>
              <span class="paner-faq__toggle" aria-hidden="true"></span>
            </summary>
            <div class="paner-faq__a rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "PanER · ЧЗВ",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Заглавие", "default": "Често задавани въпроси" },
    { "type": "richtext", "id": "text", "label": "Текст", "default": "<p>Отговори на най-честите въпроси за запитвания, количества, доставка и документи.</p>" },
    { "type": "checkbox", "id": "open_first", "label": "Отвори първия въпрос", "default": true },
    { "type": "text", "id": "contact_heading", "label": "Контакт — заглавие", "default": "Не намирате отговор?" },
    { "type": "text", "id": "contact_text", "label": "Контакт — текст", "default": "Търговският отдел отговаря в работно време, обикновено до 1 час." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Цветова схема", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Въпрос",
      "settings": [
        { "type": "text", "id": "question", "label": "Въпрос", "default": "Въпрос" },
        { "type": "richtext", "id": "answer", "label": "Отговор", "default": "<p>Отговор.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PanER · ЧЗВ",
      "blocks": [
        { "type": "question", "settings": { "question": "Защо на сайта няма цени?", "answer": "<p>Работим с фирми и цените зависят от количеството, честотата на поръчките и условията на доставка. Изпратете запитване и ще получите индивидуална оферта до 1 работен ден.</p>" } },
        { "type": "question", "settings": { "question": "Продавате ли на физически лица?", "answer": "<p>Основно работим с фирми, но можете да изпратите запитване и като физическо лице — ще ви отговорим с възможностите.</p>" } },
        { "type": "question", "settings": { "question": "Какво е минималното количество?", "answer": "<p>Минималното количество е една опаковка (кутия). За по-големи количества — кашон или палет — цената е по-изгодна.</p>" } },
        { "type": "question", "settings": { "question": "Каква е разликата между кутия, кашон и палет?", "answer": "<p>Кутията е най-малката опаковка (напр. 100 бр.). Кашонът съдържа няколко кутии, а палетът — няколко десетки кашона. Точните бройки са посочени при всеки артикул.</p>" } },
        { "type": "question", "settings": { "question": "За колко време се доставя?", "answer": "<p>Наличните артикули се доставят в рамките на 1–2 работни дни в цялата страна. За артикули по поръчка срокът се уточнява в офертата.</p>" } },
        { "type": "question", "settings": { "question": "Предлагате ли сертификати 3.1?", "answer": "<p>Да. При заявка прилагаме сертификат за качество 3.1 и декларация за съответствие към доставката.</p>" } },
        { "type": "question", "settings": { "question": "Мога ли да пратя целия си списък наведнъж?", "answer": "<p>Да — поставете артикулите и количествата в полето „Запитване по списък“ или ги изпратете на имейл като Excel файл.</p>" } },
        { "type": "question", "settings": { "question": "Как да намеря аналог по DIN, ISO или БДС?", "answer": "<p>Потърсете по номера на нормата — напр. „933“ или „ISO 4017“. Ако не намирате аналог, опишете артикула в запитването и ще ви предложим еквивалент.</p>" } }
      ]
    }
  ]
}
{% endschema %}
