{%- comment -%}
  PanER · Регистрация на фирма (заявка за фирмен профил).
  Новите клиентски акаунти на Shopify не позволяват допълнителни полета при регистрация,
  затова фирмените данни се изпращат като заявка до магазина. След проверка клиентът се създава/одобрява
  в админа с тага от Theme settings → PanER · Каталог → „Покажи цени на клиенти с таг“ (напр. b2b).
{%- endcomment -%}
<div class="paner-register page-width">
  <nav class="paner-crumbs" aria-label="Навигация">
    <a href="{{ routes.root_url }}">Начало</a><span aria-hidden="true">›</span><span aria-current="page">{{ section.settings.heading }}</span>
  </nav>

  <div class="paner-register__layout">
    <div class="paner-register__intro">
      <p class="paner-eyebrow paner-eyebrow--accent">{{ section.settings.eyebrow }}</p>
      <h1 class="paner-col__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<div class="paner-col__desc">{{ section.settings.text }}</div>{%- endif -%}

      <ol class="paner-register__steps" role="list">
        {%- for block in section.blocks -%}
          <li class="paner-register__step" {{ block.shopify_attributes }}>
            <span class="paner-step__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div>
              <b>{{ block.settings.title }}</b>
              <span>{{ block.settings.text }}</span>
            </div>
          </li>
        {%- endfor -%}
      </ol>

      <div class="paner-mini paner-register__login">
        {%- if customer -%}
          <b>Влезли сте като {{ customer.email }}</b>
          <span>Попълнете данните на фирмата, за да одобрим профила ви за фирмени цени.</span>
        {%- else -%}
          <b>Вече имате одобрен профил?</b>
          <span>Входът е с код по имейл — без парола.</span>
          <a class="button paner-btn--dark" href="{{ routes.account_login_url }}">Вход</a>
        {%- endif -%}
      </div>
    </div>

    <div class="paner-register__main">
      {%- form 'contact', id: 'PanerRegister', class: 'paner-contact__form' -%}
        {%- if form.posted_successfully? -%}
          <div class="paner-cart__done paner-contact__done" tabindex="-1" autofocus>
            <span class="paner-cart__done-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10"/></svg>
            </span>
            <h2 class="paner-cart__title">Заявката е получена</h2>
            <p>{{ section.settings.success_text }}</p>
            <div class="paner-cart__done-actions">
              {%- unless customer -%}<a class="button paner-btn--dark" href="{{ routes.account_login_url }}">Създай вход с имейла си</a>{%- endunless -%}
              <a class="button button--secondary" href="{{ routes.collections_url }}">Към каталога</a>
            </div>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="paner-inquiry__errors" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <input type="hidden" name="contact[Тип]" value="Заявка за фирмен профил">

          <fieldset class="paner-card-box">
            <legend>Данни на фирмата</legend>
            <div class="paner-grid2">
              <label class="paner-field paner-field--wide">Име на фирмата *<input class="paner-input" type="text" name="contact[Фирма]" autocomplete="organization" required></label>
              <label class="paner-field">ЕИК *<input class="paner-input" type="text" name="contact[ЕИК]" inputmode="numeric" pattern="[0-9]{9}|[0-9]{13}" title="9 или 13 цифри" required></label>
              <label class="paner-field">ДДС номер<input class="paner-input" type="text" name="contact[ДДС номер]" placeholder="BG…"></label>
              <label class="paner-field">МОЛ<input class="paner-input" type="text" name="contact[МОЛ]"></label>
              <label class="paner-field">Град *<input class="paner-input" type="text" name="contact[Град]" autocomplete="address-level2" required></label>
              <label class="paner-field paner-field--wide">Адрес за доставка / фактура<input class="paner-input" type="text" name="contact[Адрес]" autocomplete="street-address"></label>
              <label class="paner-field">Дейност
                <select class="paner-select" name="contact[Дейност]">
                  {%- assign acts = section.settings.activities | split: ',' -%}
                  {%- for a in acts -%}<option value="{{ a | strip | escape }}">{{ a | strip }}</option>{%- endfor -%}
                </select>
              </label>
              <label class="paner-field">Прогнозен месечен обем
                <select class="paner-select" name="contact[Месечен обем]">
                  <option value="до 500 €">до 500 €</option>
                  <option value="500 – 2 000 €">500 – 2 000 €</option>
                  <option value="2 000 – 10 000 €">2 000 – 10 000 €</option>
                  <option value="над 10 000 €">над 10 000 €</option>
                </select>
              </label>
            </div>
          </fieldset>

          <fieldset class="paner-card-box">
            <legend>Лице за контакт</legend>
            <div class="paner-grid2">
              <label class="paner-field">Име и фамилия *<input class="paner-input" type="text" name="contact[name]" autocomplete="name" required value="{{ customer.name }}"></label>
              <label class="paner-field">Длъжност<input class="paner-input" type="text" name="contact[Длъжност]" autocomplete="organization-title"></label>
              <label class="paner-field">Имейл (за вход и оферти) *<input class="paner-input" type="email" name="contact[email]" autocomplete="email" required spellcheck="false" autocapitalize="off" value="{{ customer.email }}"></label>
              <label class="paner-field">Телефон *<input class="paner-input" type="tel" name="contact[phone]" autocomplete="tel" required value="{{ customer.phone }}"></label>
              <label class="paner-field paner-field--wide">Какво поръчвате най-често?<textarea class="paner-input" name="contact[body]" rows="3" placeholder="напр. DIN 933 M8–M16, анкери, шпилки"></textarea></label>
            </div>
            <label class="paner-consent">
              <input type="checkbox" class="paner-cb" name="contact[Съгласие]" value="Да" required>
              <span>{{ section.settings.consent }}{% if section.settings.privacy_link != blank %} <a href="{{ section.settings.privacy_link }}">Политика за поверителност</a>{% endif %}</span>
            </label>
            <label class="paner-consent">
              <input type="checkbox" class="paner-cb" name="contact[Бюлетин]" value="Да">
              <span>Искам да получавам промоции и нови артикули по имейл.</span>
            </label>
            <button type="submit" class="button paner-btn--accent paner-contact__submit">Изпрати заявката</button>
          </fieldset>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PanER · Регистрация",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Надзаглавие", "default": "ФИРМЕН ПРОФИЛ" },
    { "type": "text", "id": "heading", "label": "Заглавие", "default": "Регистрация на фирма" },
    { "type": "richtext", "id": "text", "label": "Текст", "default": "<p>Получете индивидуални цени, по-бързи оферти и плащане по фактура. Регистрацията отнема 2 минути.</p>" },
    { "type": "text", "id": "activities", "label": "Дейности (със запетая)", "default": "Производство,Строителство и монтаж,Търговия / железария,Машини и поддръжка,Друго" },
    { "type": "text", "id": "consent", "label": "Текст за съгласие", "default": "Съгласен/на съм данните ми да бъдат обработвани за създаване на фирмен профил." },
    { "type": "url", "id": "privacy_link", "label": "Линк към политика за поверителност" },
    { "type": "text", "id": "success_text", "label": "Текст след изпращане", "default": "Ще проверим данните на фирмата и ще активираме фирмените цени до 1 работен ден. Ще получите потвърждение по имейл." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Стъпка",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Заглавие", "default": "Стъпка" },
        { "type": "text", "id": "text", "label": "Текст", "default": "Описание" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PanER · Регистрация",
      "blocks": [
        { "type": "step", "settings": { "title": "Изпратете заявка", "text": "Данни на фирмата и лице за контакт." } },
        { "type": "step", "settings": { "title": "Проверка до 1 работен ден", "text": "Потвърждаваме фирмата и ценовата група." } },
        { "type": "step", "settings": { "title": "Вход с имейл", "text": "Влизате с код по имейл и виждате фирмените условия." } }
      ]
    }
  ]
}
{% endschema %}
