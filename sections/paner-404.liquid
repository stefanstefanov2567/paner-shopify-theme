{%- comment -%} PanER · Страница 404 {%- endcomment -%}
<div class="paner-404 page-width">
  <div class="paner-404__inner">
    <span class="paner-404__icon" aria-hidden="true">{%- render 'paner-icon', name: 'nut' -%}</span>
    <p class="paner-eyebrow paner-eyebrow--accent">ГРЕШКА 404</p>
    <h1 class="paner-col__title">{{ section.settings.heading }}</h1>
    <p class="paner-col__desc">{{ section.settings.text }}</p>
    <form action="{{ routes.search_url }}" method="get" role="search" class="paner-search paner-search--inline">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
      <label class="visually-hidden" for="Paner404Search">Търсене</label>
      <span class="paner-search__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></span>
      <input id="Paner404Search" class="paner-search__input" type="search" name="q" placeholder="Норма, размер или код">
      <button type="submit" class="paner-search__go" aria-label="Търси"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
    </form>
    <div class="paner-cart__done-actions">
      <a class="button paner-btn--dark" href="{{ routes.collections_url }}">Към каталога</a>
      <a class="button button--secondary" href="{{ settings.inquiry_link | default: '/pages/contact' }}">Изпрати запитване</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PanER · 404",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Заглавие", "default": "Тази страница не съществува" },
    { "type": "text", "id": "text", "label": "Текст", "default": "Може артикулът да е преместен. Потърсете по норма или код — или ни пишете и ще го намерим." }
  ]
}
{% endschema %}
