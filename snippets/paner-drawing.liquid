{%- comment -%}
  PanER · Автоматичен технически чертеж (SVG) с размерите на артикула.
  Accepts: shape ('bolt' | 'nut' | 'washer'), d, l, b, k, s (текст), title
{%- endcomment -%}
<figure class="paner-drawing">
  <figcaption class="paner-drawing__cap"><b>{{ title | default: 'Технически чертеж' }}</b><span class="paner-mono">мм</span></figcaption>
  {%- case shape -%}
    {%- when 'nut' -%}
      <svg viewBox="0 0 520 200" role="img" aria-label="Чертеж на гайка" font-family="ui-monospace, Menlo, monospace" font-size="13">
        <g fill="none" stroke="#0F172A" stroke-width="1.6">
          <path d="M150 30 210 65v70l-60 35-60-35V65Z"/><circle cx="150" cy="100" r="34"/>
          <rect x="300" y="45" width="150" height="110"/>
        </g>
        <g stroke="#94A3B8" stroke-width="1"><path d="M300 75h150M300 125h150"/></g>
        <g stroke="#EA580C" fill="none"><path d="M90 186h120M90 178v16M210 178v16M300 30h150M300 22v16M450 22v16M470 45v110M462 45h16M462 155h16"/></g>
        <g fill="#C2410C">
          {%- if s != blank -%}<text x="122" y="182">s = {{ s }}</text>{%- endif -%}
          {%- if d != blank -%}<text x="345" y="18">d = {{ d }}</text>{%- endif -%}
          {%- if k != blank -%}<text x="482" y="104">m = {{ k }}</text>{%- endif -%}
        </g>
      </svg>
    {%- when 'washer' -%}
      <svg viewBox="0 0 520 200" role="img" aria-label="Чертеж на шайба" font-family="ui-monospace, Menlo, monospace" font-size="13">
        <g fill="none" stroke="#0F172A" stroke-width="1.6"><circle cx="150" cy="100" r="70"/><circle cx="150" cy="100" r="30"/><rect x="320" y="30" width="18" height="140"/></g>
        <g stroke="#EA580C" fill="none"><path d="M80 186h140M80 178v16M220 178v16M120 100h60M320 22h18"/></g>
        <g fill="#C2410C">
          {%- if s != blank -%}<text x="128" y="182">d2 = {{ s }}</text>{%- endif -%}
          {%- if d != blank -%}<text x="124" y="94">d1 = {{ d }}</text>{%- endif -%}
          {%- if k != blank -%}<text x="350" y="104">h = {{ k }}</text>{%- endif -%}
        </g>
      </svg>
    {%- else -%}
      <svg viewBox="0 0 560 200" role="img" aria-label="Чертеж на болт" font-family="ui-monospace, Menlo, monospace" font-size="13">
        <g fill="none" stroke="#0F172A" stroke-width="1.6">
          <rect x="40" y="60" width="40" height="80"/>
          <path d="M80 82h230v36H80"/>
          <path d="M310 82h40l6 6v24l-6 6h-40"/>
        </g>
        <g stroke="#94A3B8" stroke-width="1">
          <path d="M190 82v36M310 82v36"/>
          <path d="M206 82l-6 36M222 82l-6 36M238 82l-6 36M254 82l-6 36M270 82l-6 36M286 82l-6 36M302 82l-6 36M318 82l-6 36M334 82l-6 36M350 82l-6 36"/>
        </g>
        <g stroke="#EA580C" stroke-width="1" fill="none">
          <path d="M40 40v14M80 40v14M80 166v-20M356 166v-20M190 32v44M356 32v44"/>
          <path d="M40 46h40M80 158h276M190 38h166M380 82h20M380 118h20M392 82v36"/>
        </g>
        <g transform="translate(512 100)" fill="none" stroke="#0F172A" stroke-width="1.6"><path d="M0 -34 29.4 -17v34L0 34-29.4 17v-34z"/><circle r="15"/></g>
        <g fill="#C2410C">
          {%- if k != blank -%}<text x="46" y="34">k = {{ k }}</text>{%- endif -%}
          {%- if l != blank -%}<text x="196" y="182">l = {{ l }}</text>{%- endif -%}
          {%- if b != blank -%}<text x="246" y="28">b = {{ b }}</text>{%- endif -%}
          {%- if d != blank -%}<text x="404" y="104">d = {{ d }}</text>{%- endif -%}
          {%- if s != blank -%}<text x="486" y="160">s = {{ s }}</text>{%- endif -%}
        </g>
      </svg>
  {%- endcase -%}
</figure>
