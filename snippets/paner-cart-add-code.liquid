{%- comment -%} PanER · Добавяне в запитването по код / размер {%- endcomment -%}
<div class="paner-addcode" data-paner-addcode>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
  <label class="visually-hidden" for="PanerAddCode">Код или размер</label>
  <input class="paner-addcode__input" id="PanerAddCode" type="text" placeholder="Добави по код или размер — напр. „D931881006000“ или „934 M10“" data-paner-addcode-q autocomplete="off">
  <label class="visually-hidden" for="PanerAddCodeQty">Брой кутии</label>
  <input class="paner-addcode__qty" id="PanerAddCodeQty" type="number" min="1" value="1" data-paner-addcode-qty>
  <button type="button" class="button paner-btn--dark paner-btn--sm" data-paner-addcode-btn>Добави</button>
  <p class="paner-addcode__msg" data-paner-addcode-msg role="status" hidden></p>
</div>
