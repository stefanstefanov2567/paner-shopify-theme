{%- comment -%}
  PanER Fasteners лого (inline SVG).
  Параметри:
  - class: CSS клас (по избор)
  - variant: 'dark' (за тъмен фон) или 'light' (по подразбиране)
  - mark_only: true — само буквата „P“ (иконка)
  - uid: уникален суфикс, ако логото се показва няколко пъти на страницата
{%- endcomment -%}
{%- liquid
  assign ink = '#0F172A'
  assign paper = '#FFFFFF'
  if variant == 'dark'
    assign ink = '#FFFFFF'
    assign paper = '#1E293B'
  endif
  assign pid = 'paner-thread-' | append: uid
-%}
{%- capture pglyph -%}
<rect x="0" y="0" width="11" height="5" rx="1" fill="__INK__"/><rect x="2" y="5" width="7" height="21" fill="__INK__"/><path d="M2 9.6l7-1.8M2 12.8l7-1.8M2 16l7-1.8M2 19.2l7-1.8M2 22.4l7-1.8M2 25.6l7-1.8" stroke="__PAPER__" stroke-width="1"/><path d="M19.1 0 29.5 6v12L19.1 24 8.7 18V6Z" fill="__INK__"/><circle cx="19.1" cy="12" r="5.8" fill="#EA580C"/><circle cx="19.1" cy="12" r="3.2" fill="__PAPER__"/>
{%- endcapture -%}
{%- assign pglyph = pglyph | replace: '__INK__', ink | replace: '__PAPER__', paper -%}
{%- if mark_only -%}
<svg class="paner-logo paner-logo--mark {{ class }}" viewBox="-2.2 -5 34 36" role="img" aria-label="{{ shop.name | escape }}" xmlns="http://www.w3.org/2000/svg">{{ pglyph }}</svg>
{%- else -%}
<svg class="paner-logo {{ class }}" viewBox="0 0 112 48" role="img" aria-label="{{ shop.name | escape }}" xmlns="http://www.w3.org/2000/svg">
  <defs><pattern id="{{ pid }}" width="5" height="6" patternUnits="userSpaceOnUse" patternTransform="skewX(-35)"><rect width="3.4" height="6" fill="#EA580C"/></pattern></defs>
