{%- comment -%}
  PanER · Филтри (Storefront Filtering). Настройват се в приложението Shopify Search & Discovery.
  Accepts:
  - filters: {Array} collection.filters или search.filters
  - sort_by: {String}
  - terms: {String} при търсене
  - results_count: {Number}
  - show_price: {String}
  - clear_url: {String}
{%- endcomment -%}
{%- liquid
  assign active_count = 0
  for filter in filters
    if filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign active_count = active_count | plus: 1
      endif
    elsif filter.type == 'boolean'
      if filter.true_value.active
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor
-%}
<div class="paner-filters" data-paner-filters-panel>
  <div class="paner-filters__sheet-head">
    <strong>Филтри</strong>
    <button type="button" class="paner-icon-btn" data-paner-filters-close aria-label="Затвори филтрите">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>

  <form class="paner-filters__form" data-paner-filters id="PanerFilters">
    {%- if terms != blank -%}
      <input type="hidden" name="q" value="{{ terms | escape }}">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
    {%- endif -%}
    <input type="hidden" name="sort_by" value="{{ sort_by }}" data-paner-sort-hidden>

    <div class="paner-filters__head">
      <strong class="paner-filters__title">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
        Филтри
      </strong>
      {%- if active_count > 0 -%}
        <a class="paner-filters__clear" href="{{ clear_url }}" data-paner-ajax>Изчисти ({{ active_count }})</a>
      {%- endif -%}
    </div>

    {%- for filter in filters -%}
      {%- if filter.type == 'price_range' and show_price != 'true' -%}{%- continue -%}{%- endif -%}
      {%- liquid
        assign use_chips = true
        if filter.type == 'list'
          for value in filter.values
            if value.label.size > 7
              assign use_chips = false
              break
            endif
          endfor
          if filter.values.size > 24
            assign use_chips = false
          endif
        endif
        assign group_open = true
        if forloop.index > 6 and filter.active_values.size == 0
          assign group_open = false
        endif
      -%}
      <details class="paner-fgroup"{% if group_open %} open{% endif %}>
        <summary class="paner-fgroup__head">
          <span>{{ filter.label }}</span>
          {%- if filter.active_values.size > 0 -%}<span class="paner-fgroup__n">{{ filter.active_values.size }}</span>{%- endif -%}
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="paner-fgroup__body">
          {%- case filter.type -%}
            {%- when 'boolean' -%}
              <label class="paner-toggle">
                <span>{{ filter.true_value.label | default: filter.label }}</span>
                <input type="checkbox" name="{{ filter.true_value.param_name }}" value="{{ filter.true_value.value }}"{% if filter.true_value.active %} checked{% endif %}>
                <span class="paner-toggle__ui" aria-hidden="true"></span>
              </label>
            {%- when 'price_range' -%}
              <div class="paner-range">
                <label><span class="visually-hidden">От</span>
                  <input class="paner-input" type="number" inputmode="decimal" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" placeholder="От" min="0">
                </label>
                <label><span class="visually-hidden">До</span>
                  <input class="paner-input" type="number" inputmode="decimal" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" placeholder="До" min="0">
                </label>
              </div>
            {%- else -%}
              {%- if use_chips -%}
                <div class="paner-chips">
                  {%- for value in filter.values -%}
                    {%- assign disabled = false -%}
                    {%- if value.count == 0 and value.active == false -%}{%- assign disabled = true -%}{%- endif -%}
                    <label class="paner-chip{% if disabled %} is-disabled{% endif %}" title="{{ value.count }} артикула">
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if disabled %} disabled{% endif %}>
                      <span>{{ value.label }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <ul class="paner-checks" role="list">
                  {%- for value in filter.values -%}
                    {%- assign disabled = false -%}
                    {%- if value.count == 0 and value.active == false -%}{%- assign disabled = true -%}{%- endif -%}
                    <li{% if forloop.index > 8 %} class="paner-checks__more" hidden{% endif %}>
                      <label class="paner-check{% if disabled %} is-disabled{% endif %}">
                        <input type="checkbox" class="paner-cb" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if disabled %} disabled{% endif %}>
                        {%- if value.swatch.color -%}<span class="paner-swatch" style="background: {{ value.swatch.color }}"></span>{%- endif -%}
                        <span class="paner-check__label">{{ value.label }}</span>
                        <span class="paner-check__count">{{ value.count }}</span>
                      </label>
                    </li>
                  {%- endfor -%}
                </ul>
                {%- if filter.values.size > 8 -%}
                  <button type="button" class="paner-checks__toggle" data-paner-more>Покажи всички ({{ filter.values.size }})</button>
                {%- endif -%}
              {%- endif -%}
          {%- endcase -%}
        </div>
      </details>
    {%- endfor -%}

    {%- if filters.size == 0 -%}
      <p class="paner-filters__empty">Филтрите се добавят от приложението <b>Search &amp; Discovery</b> → Filters (норма, диаметър, дължина, клас, покритие, наличност).</p>
    {%- endif -%}

    <noscript><button type="submit" class="button">Приложи</button></noscript>
  </form>

  <div class="paner-filters__sheet-foot">
    <a class="button button--secondary" href="{{ clear_url }}" data-paner-ajax>Изчисти</a>
    <button type="button" class="button paner-btn--dark" data-paner-filters-close>Покажи {{ results_count }} артикула</button>
  </div>
</div>
