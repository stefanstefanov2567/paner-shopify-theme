{%- comment -%}
  PanER · Таблица с технически параметри.
  Чете метаполета на продукта (namespace „custom“). Показва само попълнените.
  Ключове: norma, iso, diameter, length, thread_length, thread_pitch, strength_class,
  material, coating, head_size, packaging, drawing (изображение), tech_sheet (файл), certificate (файл).

  Accepts:
  - product: {Object}
  - block: {Object}
{%- endcomment -%}
{%- liquid
  assign m = product.metafields.custom
  assign variant = product.selected_or_first_available_variant
  assign keys = 'norma,iso,diameter,length,thread_length,thread_pitch,strength_class,material,coating,head_size,packaging' | split: ','
  assign labels = 'Норма (DIN),Норма (ISO),Диаметър,Дължина,Дължина на резбата,Стъпка на резбата,Клас на якост,Материал,Покритие,Размер под ключ,Опаковка' | split: ','
  assign has_rows = false
  for key in keys
    if m[key] != blank
      assign has_rows = true
    endif
  endfor
  if product.has_only_default_variant == false
    assign has_rows = true
  endif
  if variant.sku != blank
    assign has_rows = true
  endif
-%}
{%- if has_rows or m.drawing != blank -%}
  <div class="paner-specs" {{ block.shopify_attributes }}>
    <h2 class="paner-specs__title">{{ block.settings.heading | default: 'Технически параметри' }}</h2>

    {%- if m.drawing != blank -%}
      <div class="paner-specs__drawing">
        {{ m.drawing | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 800, 1200', alt: 'Технически чертеж' }}
      </div>
    {%- endif -%}

    <table class="paner-specs__table">
      <tbody>
        {%- if variant.sku != blank -%}
          <tr><th scope="row">Код</th><td class="paner-mono">{{ variant.sku }}</td></tr>
        {%- endif -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <tr><th scope="row">{{ option.name }}</th><td>{{ option.selected_value }}</td></tr>
          {%- endfor -%}
        {%- endunless -%}
        {%- for key in keys -%}
          {%- if m[key] != blank -%}
            <tr><th scope="row">{{ labels[forloop.index0] }}</th><td>{{ m[key] | metafield_text }}</td></tr>
          {%- endif -%}
        {%- endfor -%}
      </tbody>
    </table>

    {%- if m.tech_sheet != blank or m.certificate != blank -%}
      <div class="paner-specs__docs">
        {%- if m.tech_sheet != blank -%}
          <a class="paner-doc" href="{{ m.tech_sheet.value.url }}" target="_blank" rel="noopener">
            <span class="svg-wrapper" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14"/></svg></span>
            Технически лист (PDF)
          </a>
        {%- endif -%}
        {%- if m.certificate != blank -%}
          <a class="paner-doc" href="{{ m.certificate.value.url }}" target="_blank" rel="noopener">
            <span class="svg-wrapper" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14"/></svg></span>
            Сертификат 3.1
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
