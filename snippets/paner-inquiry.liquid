{%- comment -%}
  PanER · Форма за запитване на продуктовата страница (каталожен режим).
  Изпраща се като стандартна контактна форма на Shopify — пристига на имейла на магазина
  (Settings → Notifications → Staff order notifications / Contact form).

  Accepts:
  - product: {Object}
  - block: {Object}
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'PanerInquiry-' | append: product.id
-%}
<div class="paner-inquiry" {{ block.shopify_attributes }}>
  {%- form 'contact', id: form_id, class: 'paner-inquiry__form' -%}
    {%- if form.posted_successfully? -%}
      <div class="paner-inquiry__success" role="status" tabindex="-1" autofocus>
        <strong>Запитването е изпратено.</strong>
        <span>Ще се свържем с вас до 1 работен ден с цена и наличност.</span>
      </div>
    {%- else -%}
      <div class="paner-inquiry__head">
        <h2 class="paner-inquiry__title">Запитване за цена и наличност</h2>
        <p class="paner-inquiry__lead">Цените са индивидуални за всяка фирма. Изпратете количество и ще получите оферта.</p>
      </div>

      {%- if form.errors -%}
        <div class="paner-inquiry__errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <input type="hidden" name="contact[Продукт]" value="{{ product.title | escape }}">
      <input type="hidden" name="contact[Вариант]" value="{{ variant.title | escape }}" data-paner-variant-title>
      <input type="hidden" name="contact[Код]" value="{{ variant.sku | escape }}" data-paner-variant-sku>
      <input type="hidden" name="contact[Линк]" value="{{ shop.url }}{{ product.url }}" data-paner-variant-url>

      <div class="paner-inquiry__row">
        <div class="field">
          <input class="field__input" type="number" min="1" step="1" id="{{ form_id }}-qty" name="contact[Количество]" placeholder="Количество" required>
          <label class="field__label" for="{{ form_id }}-qty">Количество *</label>
        </div>
        <div class="select">
          <label class="visually-hidden" for="{{ form_id }}-unit">Мерна единица</label>
          <select class="select__select" id="{{ form_id }}-unit" name="contact[Мерна единица]">
            <option value="бр.">бр.</option>
            <option value="кутии">кутии</option>
            <option value="кашони">кашони</option>
            <option value="палети">палети</option>
          </select>
          <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
        </div>
      </div>

      <div class="paner-inquiry__row">
        <div class="field">
          <input class="field__input" type="text" id="{{ form_id }}-name" name="contact[Име]" autocomplete="name" placeholder="Име" required>
          <label class="field__label" for="{{ form_id }}-name">Име *</label>
        </div>
        <div class="field">
          <input class="field__input" type="text" id="{{ form_id }}-company" name="contact[Фирма]" autocomplete="organization" placeholder="Фирма">
          <label class="field__label" for="{{ form_id }}-company">Фирма</label>
        </div>
      </div>

      <div class="paner-inquiry__row">
        <div class="field">
          <input class="field__input" type="email" id="{{ form_id }}-email" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" placeholder="Имейл" required>
          <label class="field__label" for="{{ form_id }}-email">Имейл *</label>
        </div>
        <div class="field">
          <input class="field__input" type="tel" id="{{ form_id }}-phone" name="contact[Телефон]" autocomplete="tel" pattern="[0-9\-\+\s]*" placeholder="Телефон">
          <label class="field__label" for="{{ form_id }}-phone">Телефон</label>
        </div>
      </div>

      <div class="field">
        <textarea class="text-area field__input" id="{{ form_id }}-body" name="contact[body]" rows="3" placeholder="Бележка"></textarea>
        <label class="form__label field__label" for="{{ form_id }}-body">Бележка (срок, обект, сертификат 3.1…)</label>
      </div>

      <button type="submit" class="button button--full-width paner-inquiry__submit">Изпрати запитване</button>
      <p class="paner-inquiry__note">Отговаряме до 1 работен ден.{% if settings.paner_phone != blank %} Или се обадете: <a href="tel:{{ settings.paner_phone | remove: ' ' }}">{{ settings.paner_phone }}</a>{% endif %}</p>
    {%- endif -%}
  {%- endform -%}

  <script type="application/json" data-paner-variants>
    [{%- for v in product.variants -%}{"id":{{ v.id }},"title":{{ v.title | json }},"sku":{{ v.sku | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
  </script>
  <script>
    (function () {
      var root = document.currentScript.closest('.paner-inquiry');
      var form = root && root.querySelector('form');
      var data = root && root.querySelector('[data-paner-variants]');
      if (!form || !data) return;
      var variants = JSON.parse(data.textContent);
      form.addEventListener('submit', function () {
        var id = new URLSearchParams(window.location.search).get('variant');
        var v = variants.find(function (x) { return String(x.id) === id; });
        if (!v) return;
        form.querySelector('[data-paner-variant-title]').value = v.title;
        form.querySelector('[data-paner-variant-sku]').value = v.sku || '';
        form.querySelector('[data-paner-variant-url]').value = window.location.href;
      });
    })();
  </script>
</div>
